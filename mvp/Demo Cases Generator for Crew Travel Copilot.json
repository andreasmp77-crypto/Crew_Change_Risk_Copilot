    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "from datetime import datetime, timedelta\nimport random\nimport re\n\n# --------------------------------------------------\n# READ INCOMING ITEMS FROM PREVIOUS NODE\n# --------------------------------------------------\n\nitems = _items\n\n\n# --------------------------------------------------\n# SEPARATE THE THREE DATASETS\n# --------------------------------------------------\n\nexisting_cases = []\nairports = []\nports = []\n\nfor item in items:\n    data = item[\"json\"]\n    fields = data.get(\"fields\", {})\n\n    if \"crew_change_id\" in fields:\n        existing_cases.append({\n            \"id\": data.get(\"id\"),\n            **fields\n        })\n\n    elif \"airport_name\" in fields:\n        airports.append({\n            \"id\": data.get(\"id\"),\n            **fields\n        })\n\n    elif \"port_name\" in fields:\n        ports.append({\n            \"id\": data.get(\"id\"),\n            **fields\n        })\n\n\n# --------------------------------------------------\n# BASIC VALIDATION\n# --------------------------------------------------\n\nif not existing_cases:\n    raise Exception(\n        \"Validation failed: No existing Crew Change Plans found.\"\n    )\n\nif not airports:\n    raise Exception(\n        \"Validation failed: No demo Airports found.\"\n    )\n\nif not ports:\n    raise Exception(\n        \"Validation failed: No demo Ports found.\"\n    )\n\n\n# --------------------------------------------------\n# FIND NEXT CREW CHANGE ID\n# --------------------------------------------------\n\nexisting_numbers = []\n\nfor case in existing_cases:\n    case_id = case.get(\"crew_change_id\", \"\")\n    match = re.search(r\"CC-(\\d+)\", case_id)\n\n    if match:\n        existing_numbers.append(int(match.group(1)))\n\nif not existing_numbers:\n    raise Exception(\n        \"Validation failed: Could not determine existing \"\n        \"Crew Change ID sequence.\"\n    )\n\nnext_number = max(existing_numbers) + 1\n\n\n# --------------------------------------------------\n# HELPER FUNCTIONS\n# --------------------------------------------------\n\ndef get_record_id(record):\n    return record.get(\"id\")\n\n\ndef random_airport(exclude_ids=None):\n    if exclude_ids is None:\n        exclude_ids = []\n\n    available = [\n        airport\n        for airport in airports\n        if airport.get(\"id\") not in exclude_ids\n    ]\n\n    if not available:\n        raise Exception(\n            \"Validation failed: No available airport after exclusions.\"\n        )\n\n    return random.choice(available)\n\n\ndef format_airtable_datetime(value):\n    \"\"\"\n    Format datetime for Airtable DateTime fields.\n    Output example:\n    2026-09-10T09:07:43Z\n    \"\"\"\n    return value.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\n# --------------------------------------------------\n# GENERATE 5 NEW DEMO CASES\n# --------------------------------------------------\n\nNUM_CASES = 5\n\nranks = [\n    \"Master\",\n    \"Chief Officer\",\n    \"Second Officer\",\n    \"Chief Engineer\",\n    \"Second Engineer\",\n    \"Third Engineer\",\n    \"Electrician\",\n    \"Bosun\",\n    \"Able Seafarer\",\n    \"Cook\"\n]\n\nmovement_types = [\n    \"Joining\",\n    \"Sign Off\"\n]\n\nvisa_statuses = [\n    \"Verified\",\n    \"Verified\",\n    \"Pending verification\",\n    \"Manual specialist check\",\n    \"Potential issue\"\n]\n\nticket_statuses = [\n    \"Not requested\",\n    \"Quoted\",\n    \"Reserved\",\n    \"Ticketed\"\n]\n\nvessel_eta_confidence_values = [\n    \"High\",\n    \"High\",\n    \"Medium\",\n    \"Medium\"\n]\n\ngenerated_cases = []\n\n\n# Use a future date for the demo\nbase_date = datetime.now() + timedelta(days=7)\n\n\n# --------------------------------------------------\n# CREATE INDIVIDUAL CASES\n# --------------------------------------------------\n\nfor i in range(NUM_CASES):\n\n    # Select a demo port\n    port = random.choice(ports)\n    port_id = get_record_id(port)\n\n    # Get the port's default destination airport\n    destination_links = port.get(\n        \"default_destination_airport\",\n        []\n    )\n\n    if not destination_links:\n        raise Exception(\n            f\"Validation failed: Port \"\n            f\"{port.get('port_name')} \"\n            \"has no default destination airport.\"\n        )\n\n    destination_airport_id = destination_links[0]\n\n    # Select origin airport\n    origin = random_airport(\n        exclude_ids=[destination_airport_id]\n    )\n\n    # Select connection airport\n    connection = random_airport(\n        exclude_ids=[\n            destination_airport_id,\n            origin.get(\"id\")\n        ]\n    )\n\n    # --------------------------------------------------\n    # CREATE VARIED DEMO SCENARIOS\n    # --------------------------------------------------\n\n    scenario = i + 1\n\n    number_of_connections = (\n        1 if scenario in [1, 2] else 2\n    )\n\n    # Different connection times\n    connection_minutes_options = [\n        180,\n        120,\n        75,\n        55,\n        40\n    ]\n\n    shortest_connection_minutes = (\n        connection_minutes_options[i]\n    )\n\n    # Different buffers before reporting deadline\n    arrival_buffer_options = [\n        600,\n        360,\n        240,\n        120,\n        60\n    ]\n\n    arrival_buffer = arrival_buffer_options[i]\n\n    # Different port transfer times\n    port_transfer_options = [\n        45,\n        60,\n        75,\n        90,\n        120\n    ]\n\n    port_transfer_minutes = (\n        port_transfer_options[i]\n    )\n\n\n    # --------------------------------------------------\n    # CREATE TRAVEL SCHEDULE\n    # --------------------------------------------------\n\n    departure = (\n        base_date + timedelta(days=i)\n    )\n\n    travel_duration_hours = (\n        12 + (number_of_connections * 4)\n    )\n\n    arrival = departure + timedelta(\n        hours=travel_duration_hours\n    )\n\n    reporting_deadline = arrival + timedelta(\n        minutes=arrival_buffer\n    )\n\n    vessel_eta = reporting_deadline + timedelta(\n        hours=6\n    )\n\n\n    # --------------------------------------------------\n    # CREATE CREW CHANGE CASE\n    # --------------------------------------------------\n\n    case = {\n\n        # Identification\n        \"crew_change_id\": (\n            f\"CC-{next_number + i:04d}\"\n        ),\n\n        # Airtable Date-only field\n        \"plan_created_date\": datetime.now().strftime(\n            \"%Y-%m-%d\"\n        ),\n\n        \"vessel_code\": (\n            f\"VSL-{((next_number + i - 1) % 10) + 1:03d}\"\n        ),\n\n        \"seafarer_id\": (\n            f\"SEA-{random.randint(1, 150):04d}\"\n        ),\n\n        \"rank\": random.choice(ranks),\n\n        \"movement_type\": random.choice(\n            movement_types\n        ),\n\n\n        # ----------------------------------------------\n        # LINKED AIRTABLE RECORDS\n        # ----------------------------------------------\n\n        \"origin_airport\": [\n            origin.get(\"id\")\n        ],\n\n        \"connection_airport\": [\n            connection.get(\"id\")\n        ],\n\n        \"destination_airport\": [\n            destination_airport_id\n        ],\n\n        \"joining_port\": [\n            port_id\n        ],\n\n\n        # ----------------------------------------------\n        # TRAVEL DETAILS\n        # ----------------------------------------------\n\n        \"number_of_connections\": (\n            number_of_connections\n        ),\n\n        \"shortest_connection_minutes\": (\n            shortest_connection_minutes\n        ),\n\n\n        # Airtable DateTime fields\n        \"scheduled_departure\": (\n            format_airtable_datetime(departure)\n        ),\n\n        \"scheduled_arrival\": (\n            format_airtable_datetime(arrival)\n        ),\n\n        \"vessel_eta\": (\n            format_airtable_datetime(vessel_eta)\n        ),\n\n        \"reporting_deadline\": (\n            format_airtable_datetime(reporting_deadline)\n        ),\n\n        \"port_transfer_minutes\": (\n            port_transfer_minutes\n        ),\n\n\n        # ----------------------------------------------\n        # OPERATIONAL READINESS\n        # ----------------------------------------------\n\n        \"port_agent_confirmed\": random.choice(\n            [True, True, True, False]\n        ),\n\n        \"vessel_eta_confidence\": random.choice(\n            vessel_eta_confidence_values\n        ),\n\n        \"visa_status\": random.choice(\n            visa_statuses\n        ),\n\n        \"ticket_status\": random.choice(\n            ticket_statuses\n        ),\n\n        \"documents_verified\": random.choice(\n            [True, True, True, False]\n        ),\n\n        \"passport_valid\": True,\n\n        \"medical_valid\": True,\n\n        \"estimated_travel_cost_eur\": random.randint(\n            700,\n            1800\n        ),\n\n\n        # ----------------------------------------------\n        # MVP PROCESSING CONTROL\n        # ----------------------------------------------\n\n        \"processing_status\": \"New\"\n    }\n\n    generated_cases.append(case)\n\n\n# --------------------------------------------------\n# FINAL VALIDATION\n# --------------------------------------------------\n\nif len(generated_cases) != NUM_CASES:\n    raise Exception(\n        f\"Generation failed: Expected {NUM_CASES} \"\n        f\"cases but generated {len(generated_cases)}.\"\n    )\n\n\n# --------------------------------------------------\n# RETURN ONE N8N ITEM PER CASE\n# --------------------------------------------------\n\nreturn [\n    {\"json\": case}\n    for case in generated_cases\n]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
